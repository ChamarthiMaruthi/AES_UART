`timescale 1 ps/ 1 ps

module aes_uart_top (
	clk_100,
	clk_3125_tx,
	clk_3125_rx,
	rst_n,
	start,
	RD_RX,
	plaintext,
	key,
	decrypted_text,
	done,
	tx,
	rx,
	enc_done,
	fifo_wr_en,
	enc_done_toggle);
