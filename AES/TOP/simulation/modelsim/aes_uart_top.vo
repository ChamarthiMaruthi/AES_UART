input 	clk_3125_tx;
input 	clk_3125_rx;
input 	rst_n;
input 	start;
output 	RD_RX;
input 	[127:0] plaintext;
input 	[127:0] key;
output 	[127:0] decrypted_text;
output 	done;
output 	tx;
input 	rx;
output 	enc_done;
output 	fifo_wr_en;
output 	enc_done_toggle;

